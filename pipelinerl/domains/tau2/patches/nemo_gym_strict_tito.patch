+def _require_auxiliary_state() -> dict[str, Any]:
+    state = _AUXILIARY_RUN_STATE.get()
+    if state is None:
+        raise RuntimeError("Tau2 auxiliary model call has no active PipelineRL run state")
+    return state
+
