+def _validate_pipelinerl_token_capture(chat_completion_dict, choice_dict, log_probs):
+    generation_log_probs = [log_prob["logprob"] for log_prob in log_probs]
+    try:
+        logprob_token_ids = [
+            int(log_prob["token"].removeprefix("token_id:"))
+            for log_prob in log_probs
+        ]
+    except (KeyError, TypeError, ValueError) as exc:
+        raise RuntimeError("vLLM returned malformed logprob token IDs") from exc
+
+    prompt_token_ids = chat_completion_dict.get("prompt_token_ids")
+    generation_token_ids = choice_dict.get("token_ids")
+    if not isinstance(prompt_token_ids, list) or not all(
+        isinstance(token_id, int) for token_id in prompt_token_ids
+    ):
+        raise RuntimeError("vLLM response is missing valid prompt_token_ids")
+    if not isinstance(generation_token_ids, list) or not all(
+        isinstance(token_id, int) for token_id in generation_token_ids
+    ):
+        raise RuntimeError("vLLM response is missing valid completion token_ids")
+    if generation_token_ids != logprob_token_ids:
+        raise RuntimeError(
+            "vLLM completion token_ids do not match logprob token IDs: "
+            f"{generation_token_ids} != {logprob_token_ids}"
+        )
+    usage = chat_completion_dict.get("usage") or {}
+    if len(prompt_token_ids) != usage.get("prompt_tokens"):
+        raise RuntimeError(
+            "vLLM prompt_token_ids length does not match usage.prompt_tokens: "
+            f"{len(prompt_token_ids)} != {usage.get('prompt_tokens')}"
+        )
+    if len(generation_token_ids) != usage.get("completion_tokens"):
+        raise RuntimeError(
+            "vLLM completion token_ids length does not match usage.completion_tokens: "
+            f"{len(generation_token_ids)} != {usage.get('completion_tokens')}"
+        )
+    return prompt_token_ids, generation_token_ids, generation_log_probs
+
