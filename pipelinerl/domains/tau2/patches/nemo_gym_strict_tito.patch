+def _attach_pipelinerl_provenance(messages, output_items):
+    captures = []
+    for message in messages:
+        if message.role != "assistant" or not isinstance(message.raw_data, Mapping):
+            continue
+        choices = message.raw_data.get("choices")
+        if not isinstance(choices, list) or not choices:
+            continue
+        raw_message = choices[0].get("message")
+        if not isinstance(raw_message, Mapping) or "prompt_token_ids" not in raw_message:
+            continue
+        missing = [field for field in _PIPELINERL_PROVENANCE_FIELDS if raw_message.get(field) is None]
+        if missing:
+            raise RuntimeError(f"Tau2 policy call is missing PipelineRL provenance fields: {missing}")
+        captures.append(raw_message)
+
+    policy_items = [item for item in output_items if hasattr(item, "prompt_token_ids")]
+    if len(policy_items) != len(captures):
+        raise RuntimeError(
+            f"Tau2 converted {len(policy_items)} policy items but captured {len(captures)} raw calls"
+        )
+
+    for item, capture in zip(policy_items, captures):
+        if (
+            item.prompt_token_ids != capture["prompt_token_ids"]
+            or item.generation_token_ids != capture["generation_token_ids"]
+        ):
+            raise RuntimeError("Tau2 converted policy item does not match its raw token capture")
+        for field in _PIPELINERL_PROVENANCE_FIELDS:
+            setattr(item, field, capture[field])
+
