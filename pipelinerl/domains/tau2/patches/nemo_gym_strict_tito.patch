+def _validate_token_count(value: Any, field: str) -> int:
+    if type(value) is not int or value < 0:
+        raise RuntimeError(f"Tau2 auxiliary model response has invalid {field}")
+    return value
+
+
+def _response_metadata(message: Any) -> tuple[str, str, int, int]:
+    raw_data = message.raw_data
+    if not isinstance(raw_data, Mapping):
+        raise RuntimeError("Tau2 auxiliary model response has no raw response mapping")
+    response_model = raw_data.get("model")
+    choices = raw_data.get("choices")
+    if not isinstance(response_model, str) or not response_model:
+        raise RuntimeError("Tau2 auxiliary model response has no model alias")
+    if not isinstance(choices, list) or len(choices) != 1 or not isinstance(choices[0], Mapping):
+        raise RuntimeError("Tau2 auxiliary model response has invalid choices")
+    finish_reason = choices[0].get("finish_reason")
+    if not isinstance(finish_reason, str) or not finish_reason:
+        raise RuntimeError("Tau2 auxiliary model response has no finish_reason")
+    usage = message.usage
+    if not isinstance(usage, Mapping):
+        raise RuntimeError("Tau2 auxiliary model response has no usage")
+    return (
+        response_model,
+        finish_reason,
+        _validate_token_count(usage.get("prompt_tokens"), "prompt_tokens"),
+        _validate_token_count(usage.get("completion_tokens"), "completion_tokens"),
+    )
+
+
+def _validate_judge_content(content: Any, expected_outcomes: tuple[str, ...]) -> None:
+    if not isinstance(content, str) or not content.strip():
+        raise _JudgeOutputInvalid("missing_content")
+    try:
+        payload = json.loads(content)
+    except json.JSONDecodeError as exc:
+        raise _JudgeOutputInvalid("invalid_json") from exc
+    if not isinstance(payload, Mapping):
+        raise _JudgeOutputInvalid("invalid_object")
+    if "results" not in payload:
+        raise _JudgeOutputInvalid("missing_results")
+    results = payload["results"]
+    if not isinstance(results, list):
+        raise _JudgeOutputInvalid("invalid_results")
+    if len(results) != len(expected_outcomes):
+        raise _JudgeOutputInvalid("result_count_mismatch")
+    for expected, result in zip(expected_outcomes, results):
+        if not isinstance(result, Mapping):
+            raise _JudgeOutputInvalid("invalid_result")
+        if result.get("expectedOutcome") != expected:
+            raise _JudgeOutputInvalid("expected_outcome_mismatch")
+        if type(result.get("metExpectation")) is not bool:
+            raise _JudgeOutputInvalid("invalid_met_expectation")
+        reasoning = result.get("reasoning")
+        if not isinstance(reasoning, str) or not reasoning.strip():
+            raise _JudgeOutputInvalid("missing_reasoning")
+
+
+def _next_user_call_position(state: dict[str, Any]) -> tuple[int, int]:
+    last_user_call = next(
+        (
+            entry
+            for entry in reversed(state["auxiliary_model_calls"])
+            if entry["role"] == "user_simulator"
+        ),
+        None,
+    )
+    if last_user_call is not None and last_user_call["failure_code"] == "empty_message":
+        return last_user_call["call_index"], last_user_call["attempt_index"] + 1
+    call_index = state["next_user_call_index"]
+    state["next_user_call_index"] += 1
+    return call_index, 1
+
+
+def _append_auxiliary_call(
+    state: dict[str, Any],
+    *,
+    role: str,
+    call_index: int,
+    attempt_index: int,
+    requested_model_alias: str,
+    response_model_alias: str,
+    prompt_tokens: int,
+    completion_tokens: int,
+    latency_s: float,
+    finish_reason: str,
+    completion_budget: int | None,
+    content: str | None,
+    failure_code: str | None,
+) -> None:
+    if not math.isfinite(latency_s) or latency_s < 0:
+        raise RuntimeError("Tau2 auxiliary model call has invalid latency")
+    state["auxiliary_model_calls"].append(
+        {
+            "role": role,
+            "call_index": call_index,
+            "attempt_index": attempt_index,
+            "requested_model_alias": requested_model_alias,
+            "response_model_alias": response_model_alias,
+            "prompt_tokens": prompt_tokens,
+            "completion_tokens": completion_tokens,
+            "latency_s": latency_s,
+            "finish_reason": finish_reason,
+            "completion_budget": completion_budget,
+            "output_character_count": len(content) if isinstance(content, str) else 0,
+            "output_sha256": (
+                hashlib.sha256(content.encode("utf-8")).hexdigest()
+                if role == "judge" and isinstance(content, str)
+                else None
+            ),
+            "failure_code": failure_code,
+        }
+    )
+
