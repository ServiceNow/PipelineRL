+async def _pipelinerl_auxiliary_generate(
+    model: str,
+    messages: list[Any],
+    tools: list[Any] | None = None,
+    tool_choice: str | None = None,
+    call_name: str | None = None,
+    **kwargs: Any,
+) -> Any:
+    state = _require_auxiliary_state()
+    if kwargs.get("stream") not in (None, False):
+        raise RuntimeError("Tau2 auxiliary model calls must be non-streaming")
+
+    if call_name == _USER_CALL_NAME:
+        role = "user_simulator"
+        original_generate = _ORIGINAL_USER_GENERATE
+        requested_model_alias = state["user_model_name"]
+        call_index, attempt_index = _next_user_call_position(state)
+        completion_budget = kwargs.get("max_tokens")
+        call_kwargs = dict(kwargs)
+        call_kwargs["api_base"] = state["user_api_base"]
+        call_kwargs["api_key"] = "dummy api key"
+    elif call_name == _JUDGE_CALL_NAME:
+        role = "judge"
+        original_generate = _ORIGINAL_JUDGE_GENERATE
+        requested_model_alias = state["judge_model_name"]
+        attempt = _JUDGE_ATTEMPT_STATE.get()
+        if attempt is None:
+            raise RuntimeError("Tau2 judge call has no active assertion context")
+        call_index = 1
+        attempt_index = attempt["attempt_index"]
+        completion_budget = attempt["completion_budget"]
+        call_kwargs = dict(kwargs)
+        call_kwargs.update(
+            {
+                "api_base": state["judge_api_base"],
+                "api_key": "dummy api key",
+                "temperature": state["judge_temperature"],
+                "top_p": state["judge_top_p"],
+                "seed": state["judge_seed"],
+                "max_tokens": completion_budget,
+            }
+        )
+    else:
+        raise RuntimeError(f"Unexpected Tau2 auxiliary call_name {call_name!r}")
+
+    start = perf_counter()
+    message = await asyncio.wait_for(
+        original_generate(
+            model=requested_model_alias,
+            messages=messages,
+            tools=tools,
+            tool_choice=tool_choice,
+            call_name=call_name,
+            **call_kwargs,
+        ),
+        timeout=state["auxiliary_model_timeout_s"],
+    )
+    latency_s = perf_counter() - start
+    response_model, finish_reason, prompt_tokens, completion_tokens = _response_metadata(message)
+    if response_model not in state["approved_model_aliases"]:
+        raise RuntimeError(
+            f"Tau2 auxiliary model returned unapproved alias {response_model!r}"
+        )
+
+    content = message.content
+    failure_code = None
+    if role == "user_simulator":
+        if not content and not message.tool_calls:
+            failure_code = "empty_message"
+    else:
+        attempt = _JUDGE_ATTEMPT_STATE.get()
+        if attempt is None:
+            raise RuntimeError("Tau2 judge call lost its assertion context")
+        expected_outcomes = attempt["expected_outcomes"]
+        try:
+            if finish_reason == "length":
+                raise _JudgeOutputInvalid("finish_reason_length")
+            _validate_judge_content(content, expected_outcomes)
+        except _JudgeOutputInvalid as exc:
+            failure_code = exc.detail_code
+            _append_auxiliary_call(
+                state,
+                role=role,
+                call_index=call_index,
+                attempt_index=attempt_index,
+                requested_model_alias=requested_model_alias,
+                response_model_alias=response_model,
+                prompt_tokens=prompt_tokens,
+                completion_tokens=completion_tokens,
+                latency_s=latency_s,
+                finish_reason=finish_reason,
+                completion_budget=completion_budget,
+                content=content,
+                failure_code=failure_code,
+            )
+            raise
+
+    _append_auxiliary_call(
+        state,
+        role=role,
+        call_index=call_index,
+        attempt_index=attempt_index,
+        requested_model_alias=requested_model_alias,
+        response_model_alias=response_model,
+        prompt_tokens=prompt_tokens,
+        completion_tokens=completion_tokens,
+        latency_s=latency_s,
+        finish_reason=finish_reason,
+        completion_budget=completion_budget,
+        content=content,
+        failure_code=failure_code,
+    )
+    return message
+
