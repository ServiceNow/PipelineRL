+async def _pipelinerl_evaluate_nl_assertions(
+    cls: type[NLAssertionsEvaluator],
+    trajectory: list[Any],
+    nl_assertions: list[str],
+) -> list[Any]:
+    state = _require_auxiliary_state()
+    expected_outcomes = tuple(nl_assertions)
+    attempts = (
+        state["judge_initial_max_tokens"],
+        state["judge_retry_max_tokens"],
+    )
+    last_error: _JudgeOutputInvalid | None = None
+    for attempt_index, completion_budget in enumerate(attempts, start=1):
+        token = _JUDGE_ATTEMPT_STATE.set(
+            {
+                "expected_outcomes": expected_outcomes,
+                "attempt_index": attempt_index,
+                "completion_budget": completion_budget,
+            }
+        )
+        try:
+            return await _ORIGINAL_NL_EVALUATE(trajectory, nl_assertions)
+        except _JudgeOutputInvalid as exc:
+            last_error = exc
+        finally:
+            _JUDGE_ATTEMPT_STATE.reset(token)
+    assert last_error is not None
+    raise _JudgeRewardInvalid(last_error.detail_code, len(attempts))
+
+
+async def _pipelinerl_calculate_nl_reward(
+    cls: type[NLAssertionsEvaluator],
+    task: Task,
+    full_trajectory: list[Any],
+) -> RewardInfo:
+    try:
+        return await _ORIGINAL_NL_CALCULATE(task, full_trajectory)
+    except _JudgeRewardInvalid as exc:
+        marker = {
+            "reason": _PIPELINERL_JUDGE_REASON,
+            "producer_stage": _PIPELINERL_JUDGE_STAGE,
+            "detail_code": exc.detail_code,
+            "attempt_count": exc.attempt_count,
+            "diagnostic": "judge output failed strict assertion validation",
+        }
+        return RewardInfo(
+            reward=0.0,
+            nl_assertions=None,
+            reward_breakdown={RewardType.NL_ASSERTION: 0.0},
+            info={_PIPELINERL_JUDGE_MARKER_KEY: marker},
+        )
+
