+def _judge_invalid_marker(result: SimulationRun) -> dict[str, Any] | None:
+    reward_info = result.reward_info
+    if reward_info is None or not isinstance(reward_info.info, Mapping):
+        return None
+    nl_info = reward_info.info.get("nl")
+    if not isinstance(nl_info, Mapping):
+        return None
+    marker = nl_info.get(_PIPELINERL_JUDGE_MARKER_KEY)
+    if marker is None:
+        return None
+    if not isinstance(marker, Mapping):
+        raise RuntimeError("Tau2 judge-invalid reward marker is malformed")
+    expected_keys = {
+        "reason",
+        "producer_stage",
+        "detail_code",
+        "attempt_count",
+        "diagnostic",
+    }
+    if set(marker) != expected_keys:
+        raise RuntimeError("Tau2 judge-invalid reward marker has unexpected fields")
+    if (
+        marker["reason"] != _PIPELINERL_JUDGE_REASON
+        or marker["producer_stage"] != _PIPELINERL_JUDGE_STAGE
+        or not isinstance(marker["detail_code"], str)
+        or not marker["detail_code"]
+        or type(marker["attempt_count"]) is not int
+        or marker["attempt_count"] not in (1, 2)
+        or not isinstance(marker["diagnostic"], str)
+        or not marker["diagnostic"]
+    ):
+        raise RuntimeError("Tau2 judge-invalid reward marker is malformed")
+    return dict(marker)
+
+
+def _rewardless_boundary_result(result: SimulationRun) -> dict[str, Any]:
+    payload = result.model_dump(mode="json")
+    reward_info = payload.get("reward_info")
+    if not isinstance(reward_info, dict) or "reward" not in reward_info:
+        raise RuntimeError("Tau2 judge-invalid result has no internal reward")
+    reward_info.pop("reward")
+    reward_breakdown = reward_info.get("reward_breakdown")
+    if isinstance(reward_breakdown, dict):
+        reward_breakdown.pop(RewardType.NL_ASSERTION.value, None)
+    return payload
+
