+def assert_tau2_runtime_revision() -> None:
+    """Fail unless the installed Tau2 VCS requirement used the pinned commit."""
+
+    try:
+        tau2_distribution = distribution("tau2")
+    except PackageNotFoundError as exc:
+        raise RuntimeError("Tau2 distribution is not installed") from exc
+
+    direct_url_text = tau2_distribution.read_text("direct_url.json")
+    if direct_url_text is None:
+        raise RuntimeError("Tau2 distribution has no PEP 610 direct_url.json")
+    try:
+        direct_url = json.loads(direct_url_text)
+    except json.JSONDecodeError as exc:
+        raise RuntimeError("Tau2 direct_url.json is malformed") from exc
+
+    vcs_info = direct_url.get("vcs_info") if isinstance(direct_url, dict) else None
+    expected = {
+        "vcs": "git",
+        "commit_id": PINNED_TAU2_RUNTIME_SHA,
+        "requested_revision": PINNED_TAU2_RUNTIME_SHA,
+    }
+    actual = (
+        {field: vcs_info.get(field) for field in expected}
+        if isinstance(vcs_info, dict)
+        else None
+    )
+    if actual != expected:
+        raise RuntimeError(f"Tau2 runtime provenance is {actual!r}, expected {expected!r}")
 
 
